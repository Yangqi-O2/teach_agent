# 复制为 .env 后按需修改（全部可选；不要提交 .env）

# —— 服务 ——
TJH_HOST=127.0.0.1
TJH_PORT=8787
# TJH_LOG_LEVEL=INFO

# —— 数据目录（默认仓库根 data/，所有持久化数据都在这里）——
# TJH_DATA_DIR=/srv/tianjianhu-data

# —— 运行环境与安全 ——
# 上线时设为 production：会自动关闭 /api/docs 与 /api/openapi.json
# TJH_ENV=production
# 需要文档时显式打开（本地调试用）
# TJH_DOCS_ENABLED=true
# 自定义域名通过反向代理访问时，若前后端不同源，把来源加进白名单（逗号分隔）
# TJH_CORS_ORIGINS=["https://example.com"]
# 安全响应头总开关（默认开，一般不用关）
# TJH_SECURITY_HEADERS=true
# 写请求来源校验（CSRF 兜底，默认开）
# TJH_CROSS_ORIGIN_GUARD=true
# 仅在 HTTPS 部署时设置，单位为秒；0 表示不下发 HSTS
# TJH_HSTS_SECONDS=31536000

# —— 后台任务 ——
# 关闭校园雷达的自动抓取（只能手动更新）。测试环境或想用外部 cron 触发时设为 0。
# TJH_CAMPUS_SCHEDULER=0

# —— OCR（仅非 macOS 需要）——
# Windows 安装包默认不进 PATH，用它直接指向可执行文件：
# TJH_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# 自定义前端产物目录（容器或分离部署时用）：
# TJH_WEB_DIST=/app/apps/web/dist

# —— 账号与会话 ——
# TJH_SESSION_DAYS=30
# 放到 HTTPS 后面时打开，避免 Cookie 明文传输
# TJH_COOKIE_SECURE=true
# 首次安装默认允许注册；装好第一个管理员后可在「成员管理」里关闭
# TJH_ALLOW_REGISTRATION=true
